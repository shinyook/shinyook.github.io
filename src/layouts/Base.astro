---
const {lang = 'ko', title = lang === 'ko' ? 'Shinyook — 기록의 조각들' : 'Shinyook — Notes on life & code', description = lang === 'ko' ? '개발하고, 배우고, 살아가며 남기는 기록.' : 'Notes on building, learning, and everyday life.', alternate} = Astro.props;
const en = lang === 'en';
const home = en ? '/en/' : '/';
const counterpart = alternate || (en ? Astro.url.pathname.replace(/^\/en/, '') || '/' : '/en' + Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);

---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title}</title><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={lang} href={canonical}/><link rel="alternate" hreflang={en ? 'ko' : 'en'} href={new URL(counterpart, Astro.site)}/><link rel="icon" href="/favicon.svg"/><script is:inline>
// Only the entry URL negotiates language; explicit article and /en/ links stay stable.
if(location.pathname==='/'){
 let preferred;try{preferred=localStorage.getItem('language')}catch{}
 const detected=(navigator.languages?.[0] || navigator.language || 'en').toLowerCase().startsWith('ko')?'ko':'en';
 if((preferred || detected)==='en')location.replace('/en/'+location.search+location.hash);
}
try{if(localStorage.theme==='dark')document.documentElement.dataset.theme='dark'}catch{}</script></head><body><div class="shell"><header><a class="logo" href={home}>shinyook<span>·</span></a><nav aria-label={en ? "Main navigation" : "주 메뉴"}><a href={home}>{en ? 'Journal' : '기록'}</a><a href={home+'about/'}>{en ? 'About' : '소개'}</a><a id="language" href={counterpart} lang={en ? 'ko' : 'en'} aria-label={en ? '한국어로 보기' : 'Read in English'}>{en ? '한국어' : 'EN'}</a><button id="theme" aria-label={en ? "Toggle light and dark theme" : "밝은 테마와 어두운 테마 전환"}>◐</button></nav></header><main><slot/></main><footer><span>© {new Date().getFullYear()} Shinyook</span><span>{en ? "One note at a time." : "천천히, 꾸준히 쌓아가는 기록."}</span><a href="https://app.pagescms.org/">{en ? 'Write ↗' : '글쓰기 ↗'}</a></footer></div><script>
document.querySelector<HTMLAnchorElement>('#language')?.addEventListener('click',e=>{const link=e.currentTarget as HTMLAnchorElement;try{localStorage.setItem('language',link.lang)}catch{}});
document.querySelector('#theme')?.addEventListener('click',()=>{const dark=document.documentElement.dataset.theme!=='dark';document.documentElement.dataset.theme=dark?'dark':'light';try{localStorage.theme=dark?'dark':'light'}catch{}})</script></body></html>
<style is:global>
:root{--bg:#f8f7f3;--fg:#242b28;--muted:#737b74;--line:#dedfd6;--accent:#567347;--card:#fffefa}html[data-theme=dark]{--bg:#1b211e;--fg:#e9ece3;--muted:#a3aea2;--line:#38423a;--accent:#b1c99b;--card:#232b25}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);font-family:system-ui,-apple-system,BlinkMacSystemFont,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;line-height:1.8}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}button,input{font:inherit}button,a,input{touch-action:manipulation}:focus-visible{outline:2px solid var(--accent);outline-offset:5px}.shell{max-width:1040px;padding:0 40px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;padding:30px 0;border-bottom:1px solid var(--line)}.logo{font-size:27px;font-weight:750;letter-spacing:-1.5px}.logo span{color:var(--accent)}nav{display:flex;align-items:center;gap:28px;font-size:14px}button{cursor:pointer}#theme{border:1px solid var(--line);color:var(--fg);background:none;border-radius:50%;width:34px;height:34px;line-height:1}main{min-height:65vh}footer{border-top:1px solid var(--line);padding:28px 0;display:flex;justify-content:space-between;gap:18px;font-size:12px;color:var(--muted);margin-top:70px}h1,h2,h3{line-height:1.4;letter-spacing:-.045em}p{word-break:keep-all;overflow-wrap:anywhere}.eyebrow{font-size:12px;letter-spacing:2px;color:var(--accent);font-weight:650}.muted{color:var(--muted)}.prose{max-width:720px;margin:60px auto}.prose h1{font-size:40px}.prose h2{margin-top:2em}.prose a{text-decoration:underline}.prose img{max-width:100%;border-radius:8px}.prose pre{padding:22px;overflow:auto;border-radius:8px}.prose blockquote{margin-left:0;border-left:3px solid var(--accent);padding-left:20px;color:var(--muted)}.prose :not(pre)>code{background:var(--line);padding:2px 5px;border-radius:4px}@media(max-width:600px){.shell{padding:0 22px}header{padding:22px 0}nav{gap:14px;font-size:12px}footer{flex-wrap:wrap}.prose h1{font-size:30px}}
</style>