---
import Base from '../../layouts/Base.astro';
export async function getStaticPaths(){const posts=await Astro.glob('../../content/posts/*.md');return posts.filter(p=>p.frontmatter.published===true).map(p=>({params:{slug:p.file.split('/').pop()?.replace('.md','')},props:{post:p}}))}
const {post}=Astro.props;const {Content,frontmatter:f}=post;
---
<Base title={f.title+' — Shinyook'} description={f.description}><article class="prose"><a href="/" class="muted">← 모든 기록</a><p class="eyebrow">{f.category} · {new Date(f.date).toISOString().slice(0,10)}</p><h1>{f.title}</h1>{f.cover && <img src={f.cover} alt=""/>}<Content/></article></Base>