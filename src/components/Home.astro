---
import Base from '../layouts/Base.astro';
const {lang='ko'} = Astro.props;
const en=lang==='en';
const home=en?'/en/':'/';
const categories={'개발':'Development','공부':'Learning','일상':'Life','에세이':'Essays'};

const all = en ? Object.values(import.meta.glob('../posts-en/*.md',{eager:true})) : Object.values(import.meta.glob('../content/posts/*.md',{eager:true}));
const posts=all.filter(p=>p.frontmatter.published === true).sort((a,b)=>new Date(b.frontmatter.date).getTime()-new Date(a.frontmatter.date).getTime());
---
<Base lang={lang}><section class="intro"><div class="eyebrow">SHINYOOK’S JOURNAL</div><h1>{en ? <>Building, learning,<br/>and living</> : <>만들고, 배우고,<br/>살아가는 이야기</>}<span>.</span></h1><p class="muted">{en ? <>From lessons in code to discoveries in everyday life.<br/>A home for thoughts worth keeping.</> : <>개발의 시행착오부터 일상의 작은 발견까지.<br/>흩어지는 생각을 이곳에 차곡차곡 담습니다.</>}</p><a class="about" href={home+"about/"}>{en ? "About this space ↗" : "이 공간에 대하여 ↗"}</a><div class="ornament" aria-hidden="true">✳</div></section><section aria-label={en ? "Journal entries" : "글 목록"}><div class="section-head"><h2>{en ? "All entries" : "모든 기록"} <small>{posts.length.toString().padStart(2,'0')}</small></h2><span class="eyebrow">NOTES & STORIES</span></div><div class="tools"><div class="filters" aria-label={en ? "Categories" : "카테고리"}>{['전체','개발','공부','일상','에세이'].map((c,i)=><button data-category={c} aria-pressed={i===0}>{en ? (categories[c] || "All") : c}</button>)}</div><input id="search" type="search" placeholder={en ? "Search entries…" : "기록 검색…"} aria-label={en ? "Search entries" : "글 검색"}/></div><div id="posts">{posts.map(p=><a class="post" href={home+'posts/'+p.file.split('/').pop()?.replace('.md','')+'/'} data-cat={p.frontmatter.category} data-search={[p.frontmatter.title,p.frontmatter.description,...(p.frontmatter.tags||[])].join(' ').toLowerCase()}><div><span class="category">{en ? categories[p.frontmatter.category] : p.frontmatter.category}</span><h3>{p.frontmatter.title}</h3><p>{p.frontmatter.description}</p><div class="tags">{(p.frontmatter.tags||[]).map(t=><span>#{t}</span>)}</div></div><span class="date">{new Date(p.frontmatter.date).toISOString().slice(0,10).replaceAll('-','.')} <span class="arrow">↗</span></span></a>)}</div><p id="empty" class="muted" hidden>{en ? "No entries here yet." : "아직 이곳에 기록이 없어요."}</p></section></Base>
<script>let category='전체';const search=document.querySelector<HTMLInputElement>('#search')!;function filter(){let n=0;document.querySelectorAll<HTMLElement>('.post').forEach(p=>{const show=(category==='전체'||p.dataset.cat===category)&&(p.dataset.search||'').includes(search.value.toLowerCase());p.hidden=!show;if(show)n++});document.querySelector<HTMLElement>('#empty')!.hidden=n>0}document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;document.querySelectorAll('[data-category]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter()}));search.addEventListener('input',filter);filter();</script>
<style>.intro{position:relative;padding:78px 0 65px;overflow:hidden}.intro h1{font-size:clamp(36px,5.5vw,58px);font-weight:650;margin:20px 0;line-height:1.35}.intro h1 span{color:var(--accent)}.intro p{font-size:16px}.about{display:inline-block;font-size:13px;margin-top:15px;border-bottom:1px solid var(--line)}.ornament{position:absolute;right:48px;top:80px;font-size:170px;font-family:serif;color:var(--accent);opacity:.45;transform:rotate(15deg)}.section-head{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line)}h2{font-size:21px}small{font-size:12px;color:var(--muted);margin-left:8px;font-weight:400}.tools{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:24px 0}.filters{display:flex;gap:7px;flex-wrap:wrap}.filters button{background:none;border:1px solid transparent;border-radius:30px;padding:5px 15px;color:var(--muted);font-size:13px}.filters button[aria-pressed=true]{background:var(--fg);color:var(--bg)}input{width:170px;background:none;color:var(--fg);border:0;border-bottom:1px solid var(--line);font-size:13px;padding:7px}.post{display:flex;justify-content:space-between;gap:24px;padding:30px 0;border-bottom:1px solid var(--line)}.post[hidden]{display:none}.category{color:var(--accent);font-size:12px;font-weight:600}h3{font-size:23px;margin:8px 0}.post p{font-size:14px;color:var(--muted);margin:0}.tags{display:flex;gap:12px;color:var(--muted);font-size:11px;margin-top:14px}.date{white-space:nowrap;font-size:12px;color:var(--muted);padding-top:34px}.arrow{margin-left:26px;color:var(--accent)}#empty{padding:40px 0}@media(max-width:600px){.intro{padding:55px 0}.ornament{right:0;top:40px;font-size:100px;opacity:.15}.section-head>.eyebrow{display:none}.tools{align-items:flex-start;flex-direction:column}.filters button{padding:5px 12px}.post{flex-direction:column;gap:10px}.date{padding-top:0}h3{font-size:21px}}</style>