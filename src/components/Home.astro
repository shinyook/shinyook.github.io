---
import Base from '../layouts/Base.astro';
const {lang='ko'} = Astro.props;
const en=lang==='en';
const home=en?'/en/':'/';
const categories={'개발':'Development','공부':'Learning','일상':'Life','에세이':'Essays','UK':'UK'};

const all = en ? Object.values(import.meta.glob('../posts-en/*.md',{eager:true})) : Object.values(import.meta.glob('../content/posts/*.md',{eager:true}));
const posts=all.filter(p=>p.frontmatter.published === true).sort((a,b)=>new Date(b.frontmatter.date).getTime()-new Date(a.frontmatter.date).getTime());
---
<Base lang={lang}><section class="feed" aria-label={en ? "Journal entries" : "글 목록"}><div class="tools"><div class="filters" aria-label={en ? "Categories" : "카테고리"}>{['전체','개발','공부','일상','에세이','UK'].map((c,i)=><button data-category={c} aria-pressed={i===0}>{en ? (categories[c] || "All") : c}</button>)}</div><input id="search" type="search" placeholder={en ? "Search entries…" : "기록 검색…"} aria-label={en ? "Search entries" : "글 검색"}/></div><div id="posts">{posts.map(p=><a class="post" href={home+'posts/'+p.file.split('/').pop()?.replace('.md','')+'/'} data-cat={p.frontmatter.category} data-search={[p.frontmatter.title,p.frontmatter.description,...(p.frontmatter.tags||[])].join(' ').toLowerCase()}>{p.frontmatter.cover && <img class="cover" src={p.frontmatter.cover} alt="" loading="lazy"/>}<div class="card-body"><span class="category">{en ? categories[p.frontmatter.category] : p.frontmatter.category}</span><h3>{p.frontmatter.title}</h3><p>{p.frontmatter.description}</p><div class="tags">{(p.frontmatter.tags||[]).map(t=><span>#{t}</span>)}</div><span class="date">{new Date(p.frontmatter.date).toISOString().slice(0,10).replaceAll('-','.')} <span class="arrow" aria-hidden="true">↗</span></span></div></a>)}</div><p id="empty" class="muted" hidden>{en ? "No entries here yet." : "아직 이곳에 기록이 없어요."}</p></section></Base>
<script>let category='전체';const search=document.querySelector<HTMLInputElement>('#search')!;function filter(){let n=0;document.querySelectorAll<HTMLElement>('.post').forEach(p=>{const show=(category==='전체'||p.dataset.cat===category)&&(p.dataset.search||'').includes(search.value.toLowerCase());p.hidden=!show;if(show)n++});document.querySelector<HTMLElement>('#empty')!.hidden=n>0}document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;document.querySelectorAll('[data-category]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter()}));search.addEventListener('input',filter);filter();</script>
<style>
.feed{padding-top:14px}.tools{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:22px 0 30px}.filters{display:flex;gap:5px;flex-wrap:wrap}.filters button{background:none;border:1px solid transparent;border-radius:30px;padding:6px 14px;color:var(--muted);font-size:13px}.filters button[aria-pressed=true]{background:var(--fg);color:var(--bg)}input{width:170px;background:none;color:var(--fg);border:0;border-bottom:1px solid var(--line);font-size:13px;padding:7px}#posts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;align-items:start}.post{display:block;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:var(--card);transition:transform .18s,border-color .18s}.post:hover{transform:translateY(-3px);border-color:var(--accent);color:var(--fg)}.post[hidden]{display:none}.cover{display:block;width:100%;aspect-ratio:16/10;object-fit:cover}.card-body{padding:27px}.category{color:var(--accent);font-size:12px;font-weight:600}h3{font-size:24px;margin:12px 0;overflow-wrap:anywhere}.post p{font-size:14px;color:var(--muted);margin:0}.tags{display:flex;gap:10px;flex-wrap:wrap;color:var(--muted);font-size:11px;margin-top:22px}.date{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:24px;padding-top:16px;border-top:1px solid var(--line)}.arrow{color:var(--accent)}#empty{padding:70px 0;text-align:center}@media(prefers-reduced-motion:reduce){.post{transition:none}.post:hover{transform:none}}@media(max-width:700px){.tools{align-items:flex-start;flex-direction:column;gap:18px}.filters button{padding:6px 12px}#posts{grid-template-columns:1fr;gap:18px}.card-body{padding:24px}h3{font-size:23px}}
</style>
